    -- Dynamic Target Position Helper (Accurate Center Hitbox / Neck Red Dot)
    local function getTargetPartPosition(character, partMode)
        if not character then return nil, nil, nil end
        partMode = partMode or tostring(AimTargetPartDropdown.Value)

        local head = character:FindFirstChild("Head")
        local upperTorso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")

        -- 1. HEAD / RED DOT (หัวผู้เล่น 100% - Hardware Locked to Exact Server Hitbox)
        if partMode:find("Head") or partMode:find("หัว") or partMode:find("จุดแดง") or partMode:find("Dot") then
            if WarzHitboxesModule and WarzHitboxesModule.DataAimPoints then
                local pts = nil
                pcall(function()
                    pts = WarzHitboxesModule.DataAimPoints(character, {"Bip01_Head"})
                end)
                if pts and pts[1] and pts[1].Position then
                    return pts[1].Position, head or upperTorso, Vector3.zero
                end
            end
            if head and head:IsA("BasePart") then
                return head.Position, head, Vector3.zero
            elseif upperTorso and upperTorso:IsA("BasePart") then
                local localOffset = Vector3.new(0, upperTorso.Size.Y * 0.5 + 0.6, 0)
                return upperTorso.CFrame:PointToWorldSpace(localOffset), upperTorso, localOffset
            end
        end

        -- 2. NECK (ล็อคคอ)
        if partMode:find("Neck") or partMode:find("คอ") then
            if WarzHitboxesModule and WarzHitboxesModule.DataAimPoints then
                local pts = nil
                pcall(function()
                    pts = WarzHitboxesModule.DataAimPoints(character, {"Bip01_Neck"})
                end)
                if pts and pts[1] and pts[1].Position then
                    return pts[1].Position, head or upperTorso, Vector3.zero
                end
            end
            if upperTorso and upperTorso:IsA("BasePart") then
                local neckAtt = upperTorso:FindFirstChild("NeckRigAttachment") or upperTorso:FindFirstChild("NeckAttachment")
                if neckAtt and neckAtt:IsA("Attachment") then
                    return neckAtt.WorldPosition, upperTorso, neckAtt.Position
                end
                local localOffset = Vector3.new(0, upperTorso.Size.Y * 0.45, 0)
                return upperTorso.CFrame:PointToWorldSpace(localOffset), upperTorso, localOffset
            elseif head and head:IsA("BasePart") then
                local localOffset = Vector3.new(0, -head.Size.Y * 0.45, 0)
                return head.CFrame:PointToWorldSpace(localOffset), head, localOffset
            end
        end

        -- 3. UPPER TORSO / CHEST (ลำตัว)
        if WarzHitboxesModule and WarzHitboxesModule.DataAimPoints then
            local pts = nil
            pcall(function()
                pts = WarzHitboxesModule.DataAimPoints(character, {"Bip01_Spine1"})
            end)
            if pts and pts[1] and pts[1].Position then
                return pts[1].Position, upperTorso or head, Vector3.zero
            end
        end

        if upperTorso and upperTorso:IsA("BasePart") then
            return upperTorso.Position, upperTorso, Vector3.zero
        end

        if head and head:IsA("BasePart") then
            return head.Position, head, Vector3.zero
        end

        return nil, nil, nil
    end

    local function isCharacterAlive(char)
        if not char or not char.Parent then return false end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local isDead = char:GetAttribute("WarzDead") == true or (hum and hum.Health <= 0)
        return not isDead
    end

    -- Velocity Prediction (Tightly clamped to avoid overshooting or flying above head)
    local function applyPrediction(targetPos, targetChar)
        if not (AimPredictionToggle and AimPredictionToggle.Value) or not targetChar then
            return targetPos
        end
        local root = targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("UpperTorso") or targetChar:FindFirstChild("Torso")
        if root and root:IsA("BasePart") then
            local vel = root.AssemblyLinearVelocity or root.Velocity
            if vel and vel.Magnitude > 2 then
                -- Ignore vertical velocity so jumping NEVER shifts bullets above head
                local horizVel = Vector3.new(vel.X, 0, vel.Z)
                local dist = (Camera.CFrame.Position - targetPos).Magnitude
                local timeToTarget = math.clamp(dist / 3500, 0, 0.015)
                return targetPos + (horizVel * timeToTarget)
            end
        end
        return targetPos
    end

    -- Raycast Wall / Visibility Check (Properly ignores local player TPS visuals)
    local function isTargetVisible(targetPos, targetChar)
        if not (WallCheckToggle and WallCheckToggle.Value) then return true end
        local origin = Camera.CFrame.Position
        local dir = targetPos - origin
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude

        local ignoreList = {Camera}
        if LocalPlayer.Character then
            table.insert(ignoreList, LocalPlayer.Character)
        end
        local heroVisuals = workspace:FindFirstChild("HeroVisualsLocal")
        if heroVisuals then
            table.insert(ignoreList, heroVisuals)
        end
        local warzFx = workspace:FindFirstChild("WarzFx")
        if warzFx then
            table.insert(ignoreList, warzFx)
        end
        rayParams.FilterDescendantsInstances = ignoreList
        rayParams.IgnoreWater = true

        local result = workspace:Raycast(origin, dir, rayParams)
        if not result then return true end
        if result.Instance and result.Instance:IsDescendantOf(targetChar) then
            return true
        end
        return false
    end

    -- Best Target Selector with Priority Sorting
    local function getBestTarget()
        local mousePos = UserInputService:GetMouseLocation()
        local maxFov = tonumber(AimFovSlider.Value) or 250
        local myPos = Camera.CFrame.Position
        local priorityMode = tostring(AimPriorityDropdown.Value)

        local bestScore = math.huge
        local bestPos = nil
        local bestPart = nil
        local bestChar = nil

        local function checkChar(char, isDead)
            if not char or isDead or not isCharacterAlive(char) then return end

            local rawPos, adornee = getTargetPartPosition(char)
            if not rawPos then return end

            local screenPos, onScreen = Camera:WorldToViewportPoint(rawPos)
            if not (onScreen and screenPos.Z > 0) then return end

            local mouseDist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
            if mouseDist > maxFov then return end

            if not isTargetVisible(rawPos, char) then return end

            local score = mouseDist
            if priorityMode:find("Health") or priorityMode:find("เลือด") then
                local hum = char:FindFirstChildOfClass("Humanoid")
                local hp = hum and hum.Health or 100
                score = hp + (mouseDist * 0.15)
            elseif priorityMode:find("Distance") or priorityMode:find("ระยะ") then
                local worldDist = (myPos - rawPos).Magnitude
                score = worldDist + (mouseDist * 0.1)
            end

            if score < bestScore then
                bestScore = score
                bestPos = rawPos
                bestPart = adornee
                bestChar = char
            end
        end

        -- 1. Players
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                checkChar(player.Character, player:GetAttribute("CSGO_Dead") == true or player:GetAttribute("WarzDead") == true)
            end
        end

        -- 2. Dummies / Targets / Zombies
        for _, containerName in ipairs({"WarzDummies", "Targets", "Zombies"}) do
            local container = workspace:FindFirstChild(containerName)
            if container then
                for _, obj in ipairs(container:GetChildren()) do
                    checkChar(obj, false)
                end
            end
        end

        return bestPos, bestPart, bestChar
    end

    -- Active Target Cache
    local lockedTargetChar = nil

    -- Target for Firing (Silent Aim & Redirection)
    local function getTargetForShot()
        local partMode = tostring(SilentAimTargetDropdown.Value)
        if partMode:find("Same") or partMode:find("ตาม") then
            partMode = tostring(AimTargetPartDropdown.Value)
        end

        if lockedTargetChar and isCharacterAlive(lockedTargetChar) then
            local pos, part = getTargetPartPosition(lockedTargetChar, partMode)
            if pos and isTargetVisible(pos, lockedTargetChar) then
                return pos, part, lockedTargetChar
            end
        end

        local pos, part, char = getBestTarget()
        if char then
            local customPos, customPart = getTargetPartPosition(char, partMode)
            if customPos then
                return customPos, customPart, char
            end
        end
        return pos, part, char
    end

    -- Smart Water Cast Point Detector (Fixes "There is an obstruction at the swing point")
    local function GetValidWaterCastPoint()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head") or root
        local cam = Workspace.CurrentCamera
        if not (root and cam) then return nil end

        local origin = cam.CFrame.Position
        local look = cam.CFrame.LookVector

        local rParams = RaycastParams.new()
        rParams.FilterType = Enum.RaycastFilterType.Exclude
        rParams.FilterDescendantsInstances = { char }
        rParams.IgnoreWater = false

        -- 1. Direct camera view
        local hit = Workspace:Raycast(origin, look * 90, rParams)
        if hit and hit.Material == Enum.Material.Water then
            local obsParams = RaycastParams.new()
            obsParams.FilterType = Enum.RaycastFilterType.Exclude
            obsParams.FilterDescendantsInstances = { char }
            obsParams.IgnoreWater = true
            local obs = Workspace:Raycast(head.Position, hit.Position - head.Position, obsParams)
            if not obs or (obs.Position - hit.Position).Magnitude < 1.0 then
                return hit.Position + Vector3.new(0, 0.1, 0)
            end
        end

        -- 2. Fan sweep in front of player
        local angles = { 0, 10, -10, 20, -20, 30, -30, 45, -45 }
        local pitches = { -15, -25, -35, -45, -10 }

        for _, pitch in ipairs(pitches) do
            for _, yaw in ipairs(angles) do
                local dir = (CFrame.Angles(0, math.rad(yaw), 0) * root.CFrame.LookVector)
                local rayDir = (Vector3.new(dir.X, math.sin(math.rad(pitch)), dir.Z)).Unit * 60

                local sweepHit = Workspace:Raycast(head.Position, rayDir, rParams)
                if sweepHit and sweepHit.Material == Enum.Material.Water then
                    local obsParams = RaycastParams.new()
                    obsParams.FilterType = Enum.RaycastFilterType.Exclude
                    obsParams.FilterDescendantsInstances = { char }
                    obsParams.IgnoreWater = true

                    local obsHit = Workspace:Raycast(head.Position, sweepHit.Position - head.Position, obsParams)
                    if not obsHit or (obsHit.Position - sweepHit.Position).Magnitude < 1.0 then
                        return sweepHit.Position + Vector3.new(0, 0.1, 0)
                    end
                end
            end
        end

        -- 3. Downward raycast fallback across front
        for dist = 10, 35, 5 do
            local fwd = root.CFrame.LookVector
            local topPos = root.Position + fwd * dist + Vector3.new(0, 10, 0)
            local downHit = Workspace:Raycast(topPos, Vector3.new(0, -30, 0), rParams)
            if downHit and downHit.Material == Enum.Material.Water then
                local obsParams = RaycastParams.new()
                obsParams.FilterType = Enum.RaycastFilterType.Exclude
                obsParams.FilterDescendantsInstances = { char }
                obsParams.IgnoreWater = true
                local obs = Workspace:Raycast(head.Position, downHit.Position - head.Position, obsParams)
                if not obs or (obs.Position - downHit.Position).Magnitude < 1.0 then
                    return downHit.Position + Vector3.new(0, 0.1, 0)
                end
            end
        end

        return nil
    end
    getgenv()._WarzGetValidWaterCastPoint = GetValidWaterCastPoint

    -- Hook Silent Aim & FishingStart Obstruction Bypass
    local function hookSilentAim()
        local function redirectShot(args)
            if not (SilentAimToggle and SilentAimToggle.Value) then
                return false
            end
            local success, targetPos = pcall(getTargetForShot)
            if not success or not targetPos or typeof(targetPos) ~= "Vector3" then
                return false
            end

            local camPos = (typeof(args[4]) == "Vector3" and args[4]) or Camera.CFrame.Position
            local barrelPos = (typeof(args[5]) == "Vector3" and args[5]) or nil

            -- Use barrel origin if available to completely kill TPS camera parallax
            local shotOrigin = barrelPos or camPos
            local diff = targetPos - shotOrigin
            if diff.Magnitude >= 0.05 then
                local directLook = diff.Unit
                args[1] = directLook

                -- 1. Zero spread seed (eliminates random deviation on server)
                args[2] = 0

                -- 2. Force fireStance into clean pinpoint zero-spread state
                if typeof(args[3]) == "table" then
                    args[3].currentSpread = 0
                    args[3].finishedAiming = true
                    args[3].inScope = true
                    args[3].quickScope = true
                    args[3].onGround = true
                    args[3].jumping = false
                    args[3].running = false
                    local pitch = math.asin(math.clamp(directLook.Y, -1, 1))
                    local yaw = math.atan2(-directLook.X, -directLook.Z)
                    args[3].pitch = pitch
                    args[3].yaw = yaw
                end

                -- 3. Synchronize camera origin to barrel position so camera raycast also hits target exactly
                if barrelPos then
                    args[4] = barrelPos
                end

                return true
            end
            return false
        end

        getgenv()._WarzRedirectShot = redirectShot

        if not getgenv()._WarzSilentAimHooked then
            getgenv()._WarzSilentAimHooked = true

            if typeof(hookmetamethod) == "function" then
                local origNamecall
                origNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                    local method = getnamecallmethod()
                    if (method == "FireServer" or method == "fireServer") and (self == FireRequestRemote or (self and self.Name == "FireRequest" and self:IsA("RemoteEvent"))) then
                        local args = table.pack(...)
                        if getgenv()._WarzRedirectShot then
                            pcall(getgenv()._WarzRedirectShot, args)
                        end
                        return origNamecall(self, table.unpack(args, 1, args.n))
                    end

                    -- Fix FishingStart Obstruction: replace buried ground cast point with water surface
                    if (method == "FireServer" or method == "fireServer") and (self == FishingStartRemote or (self and self.Name == "FishingStart" and self:IsA("RemoteEvent"))) then
                        local args = table.pack(...)
                        local validPoint = GetValidWaterCastPoint()
                        if validPoint then
                            args[3] = validPoint
                        end
                        if type(FishingModule) == "table" and FishingModule.Press then
                            local ups = getupvalues(FishingModule.Press)
                            local sendCast = ups[7]
                            if type(sendCast) == "function" then
                                pcall(setupvalue, sendCast, 10, validPoint or args[3])
                            end
                        end
                        local directSuccess, directRet = pcall(self.FireServer, self, table.unpack(args, 1, args.n))
                        if directSuccess then
                            return directRet
                        end
                        setnamecallmethod(method)
                        return origNamecall(self, table.unpack(args, 1, args.n))
                    end

                    return origNamecall(self, ...)
                end))
            elseif typeof(hookfunction) == "function" and FireRequestRemote and FireRequestRemote.FireServer then
                local origFireServer
                origFireServer = hookfunction(FireRequestRemote.FireServer, newcclosure(function(self, ...)
                    local args = table.pack(...)
                    if (self == FireRequestRemote or (self and self.Name == "FireRequest")) and getgenv()._WarzRedirectShot then
                        pcall(getgenv()._WarzRedirectShot, args)
                    end
                    return origFireServer(self, table.unpack(args, 1, args.n))
                end))
            end

            if typeof(hookfunction) == "function" and FishingStartRemote and FishingStartRemote.FireServer then
                local origFishingStart
                origFishingStart = hookfunction(FishingStartRemote.FireServer, newcclosure(function(self, ...)
                    local args = table.pack(...)
                    if (self == FishingStartRemote or (self and self.Name == "FishingStart")) then
                        local validPoint = GetValidWaterCastPoint()
                        if validPoint then
                            args[3] = validPoint
                        end
                    end
                    return origFishingStart(self, table.unpack(args, 1, args.n))
                end))
            end
        end
    end
    pcall(hookSilentAim)

