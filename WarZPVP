    -- Authoritative Medical Item Engine & Caching
    local cachedBackpack = nil
    local lastHealTime = 0
    local isRestocking = false

    local function getLiveBackpack()
        if cachedBackpack and cachedBackpack.Slots and #cachedBackpack.Slots >= 8 then
            return cachedBackpack
        end
        for _, v in pairs(getgc(true)) do
            if typeof(v) == "table" and rawget(v, "Backpack") and typeof(v.Backpack) == "table" and v.Backpack.Slots then
                cachedBackpack = v.Backpack
                return cachedBackpack
            end
        end
        return nil
    end

    -- Extract medical items from both memory Backpack and Quickslots UI
    local function getAvailableMeds()
        local meds = {}

        -- Method 1: Check memory backpack quickslots (slots 3..6)
        local bp = getLiveBackpack()
        if bp and bp.Slots then
            for slot = 3, 6 do
                local slotData = bp.Slots[slot]
                if slotData and slotData.ItemId ~= "" and (tonumber(slotData.Qty) or 0) > 0 then
                    local id = slotData.ItemId
                    local itemInfo = ConfigModule and ConfigModule.ShopItem and ConfigModule.ShopItem(id)
                    local isMed = (itemInfo and itemInfo.Kind == "Medical") or id:find("Bandage") or id:find("Medkit")
                    if isMed then
                        table.insert(meds, {
                            Slot = slot,
                            ItemId = id,
                            Name = itemInfo and itemInfo.Name or id,
                            Qty = tonumber(slotData.Qty) or 1,
                            HealAmount = (itemInfo and tonumber(itemInfo.HealAmount)) or (id:find("Medkit") and 100 or 45)
                        })
                    end
                end
            end
        end

        -- Method 2: Fallback to reading Quickslots GUI directly
        if #meds == 0 then
            pcall(function()
                local gui = LocalPlayer:FindFirstChild("PlayerGui")
                local bagHud = gui and gui:FindFirstChild("CSGO_UI") and gui.CSGO_UI:FindFirstChild("Root") and gui.CSGO_UI.Root:FindFirstChild("BagHud")
                local qs = bagHud and bagHud:FindFirstChild("WarzPauseStage") and bagHud.WarzPauseStage:FindFirstChild("Frame") and bagHud.WarzPauseStage.Frame:FindFirstChild("Loadout") and bagHud.WarzPauseStage.Frame.Loadout:FindFirstChild("Quickslots")
                if qs then
                    local slotIdx = 3
                    for _, btn in ipairs(qs:GetChildren()) do
                        if btn:IsA("GuiObject") then
                            local nameLbl = btn:FindFirstChild("ItemName", true)
                            local qtyLbl = btn:FindFirstChild("Quantity", true) or btn:FindFirstChild("Qty", true)
                            local itemName = nameLbl and nameLbl.Text or ""
                            local qty = tonumber(qtyLbl and qtyLbl.Text:match("%d+")) or 1
                            if itemName ~= "" and qty > 0 then
                                local resolvedId = nil
                                if itemName:find("Bandages DX") or itemName == "Bandages DX" then
                                    resolvedId = "BandagesDX"
                                elseif itemName:find("Bandages") or itemName == "Bandages" then
                                    resolvedId = "Bandages"
                                elseif itemName:find("Medkit") or itemName == "Medkit" then
                                    resolvedId = "Medkit"
                                elseif ConfigModule and ConfigModule.ShopItem then
                                    local itemInfo = ConfigModule.ShopItem(itemName)
                                    if itemInfo and itemInfo.Kind == "Medical" then
                                        resolvedId = itemInfo.Id
                                    end
                                end

                                if resolvedId then
                                    table.insert(meds, {
                                        Slot = slotIdx,
                                        ItemId = resolvedId,
                                        Name = itemName,
                                        Qty = qty,
                                        HealAmount = resolvedId:find("Medkit") and 100 or 45
                                    })
                                end
                            end
                            slotIdx = slotIdx + 1
                        end
                    end
                end
            end)
        end

        -- Method 3: Default active fallback for Deathmatch if slots are obscured
        if #meds == 0 then
            table.insert(meds, { Slot = 3, ItemId = "BandagesDX", Name = "Bandages DX", Qty = 1, HealAmount = 45 })
            table.insert(meds, { Slot = 4, ItemId = "Medkit", Name = "Medkit", Qty = 1, HealAmount = 100 })
        end

        return meds
    end

    -- Core Auto Heal Execution (Thread-Safe & Anti-Spam)
    local function executeAutoHeal(triggerSource)
        if not AutoHealToggle.Value or not UseItemRemote then return end

        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not (char and hum and hum.Health > 0) then return end
        if char:GetAttribute("WarzDead") == true or LocalPlayer:GetAttribute("CSGO_Dead") == true then return end

        local hp = hum.Health
        local maxHp = hum.MaxHealth > 0 and hum.MaxHealth or 100
        local hpPct = (hp / maxHp) * 100
        local threshold = tonumber(AutoHealHpSlider.Value) or 75

        if hpPct > threshold then return end

        -- Fast Throttle (0.05s) to prevent single-tick micro loops while allowing instant continuous healing
        local now = os.clock()
        if (now - lastHealTime) < 0.05 then
            return
        end

        local availableMeds = getAvailableMeds()
        local targetMed = nil
        local priorityMode = tostring(AutoHealPriorityDropdown.Value)
        local missingHp = maxHp - hp

        if #availableMeds > 0 then
            if priorityMode:find("Smart") or priorityMode:find("ฉลาด") then
                if missingHp >= 50 then
                    for _, m in ipairs(availableMeds) do
                        if m.ItemId == "Medkit" or m.HealAmount >= 80 then
                            targetMed = m
                            break
                        end
                    end
                end
                if not targetMed then
                    for _, m in ipairs(availableMeds) do
                        if m.ItemId:find("Bandage") then
                            targetMed = m
                            break
                        end
                    end
                end
                targetMed = targetMed or availableMeds[1]
            elseif priorityMode:find("Medkit") then
                for _, m in ipairs(availableMeds) do
                    if m.ItemId:find("Medkit") or m.HealAmount >= 80 then
                        targetMed = m
                        break
                    end
                end
                targetMed = targetMed or availableMeds[1]
            elseif priorityMode:find("Bandages") then
                for _, m in ipairs(availableMeds) do
                    if m.ItemId:find("Bandage") then
                        targetMed = m
                        break
                    end
                end
                targetMed = targetMed or availableMeds[1]
            else
                targetMed = availableMeds[1]
            end
        end

        if targetMed then
            lastHealTime = os.clock()
            UseItemRemote:FireServer(targetMed.Slot, targetMed.ItemId)

            -- Instant Cooldown Bypass / Reset on Client Attributes
            pcall(function()
                LocalPlayer:SetAttribute("WarzMedCooldownUntil", 0)
                LocalPlayer:SetAttribute("WarzMedCdLeft", 0)
            end)

            if AutoHealNotifyToggle.Value then
                Fluent:Notify({
                    Title = "Auto Heal",
                    Content = string.format("ปั้มยา: %s (เลือดเหลือ %d%%)", targetMed.Name, math.floor(hpPct)),
                    Duration = 2
                })
            end

            -- Instant Switch back to Slot 1 (Primary Gun) - 0ms immediate execution, no delay
            if AutoSwitchSlot1Toggle and AutoSwitchSlot1Toggle.Value then
                local switchRemote = SwitchWeaponRequestRemote or (RemotesFolder and RemotesFolder:FindFirstChild("SwitchWeaponRequest"))
                if switchRemote then
                    switchRemote:FireServer(1)
                    task.defer(function()
                        if switchRemote then
                            switchRemote:FireServer(1)
                        end
                    end)
                    task.delay(0.04, function()
                        if switchRemote then
                            switchRemote:FireServer(1)
                        end
                    end)
                end
            end
        elseif AutoRestockToggle.Value and SwapBagSlotRemote and not isRestocking then
            -- Auto Restock: Move medical item from bag (slots 9+) to quickslot 3
            local bp = getLiveBackpack()
            if bp and bp.Slots then
                local foundBagSlot = nil
                for s = 9, #bp.Slots do
                    local slotData = bp.Slots[s]
                    if slotData and slotData.ItemId ~= "" and (tonumber(slotData.Qty) or 0) > 0 then
                        local itemInfo = ConfigModule and ConfigModule.ShopItem and ConfigModule.ShopItem(slotData.ItemId)
                        local isMed = (itemInfo and itemInfo.Kind == "Medical") or slotData.ItemId:find("Bandage") or slotData.ItemId:find("Medkit")
                        if isMed then
                            foundBagSlot = s
                            break
                        end
                    end
                end

                if foundBagSlot then
                    isRestocking = true
                    SwapBagSlotRemote:FireServer(foundBagSlot, 3)
                    task.delay(0.25, function()
                        isRestocking = false
                        cachedBackpack = nil
                    end)
                end
            end
        end
    end

    -- 1. Reactive Hook: React immediately within 0ms when health decreases
    local healthConn = nil
    local function hookCharacterHealth(char)
        if healthConn then
            healthConn:Disconnect()
            healthConn = nil
        end
        if not char then return end
        local hum = char:WaitForChild("Humanoid", 5)
        if hum then
            healthConn = hum.HealthChanged:Connect(function(newHp)
                if AutoHealToggle.Value and newHp > 0 then
                    executeAutoHeal("HealthChanged")
                end
            end)
        end
    end

    if LocalPlayer.Character then
        hookCharacterHealth(LocalPlayer.Character)
    end
    LocalPlayer.CharacterAdded:Connect(function(char)
        cachedBackpack = nil
        hookCharacterHealth(char)
    end)

    -- 2. Polling Loop: Constant fallback check every 0.05s (rapid tick damage recovery)
    task.spawn(function()
        while true do
            task.wait(0.05)
            if AutoHealToggle.Value then
                executeAutoHeal("Tick")
            end
        end
    end)
end

