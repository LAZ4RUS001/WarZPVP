    -- Auto Fishing Helpers
    local function GetFishingProfile()
        local sessionData = nil
        if type(FishingModule) == "table" and FishingModule.Press then
            local ups = getupvalues(FishingModule.Press)
            local sendCast = ups[7]
            if type(sendCast) == "function" then
                local sendCastUps = getupvalues(sendCast)
                local getSession = sendCastUps[1]
                if type(getSession) == "function" then
                    pcall(function() sessionData = getSession() end)
                end
            end
        end
        if sessionData and sessionData.profile and sessionData.profile.Backpack then
            return sessionData.profile
        end
        for _, v in pairs(getreg()) do
            if type(v) == "table" and rawget(v, "Backpack") and rawget(v, "Account") then
                return v
            end
        end
        return nil
    end

    local function FindFishingRodAndBait(profile)
        local rodSlot, rodId = nil, nil
        local baitSlot, baitId, baitQty = nil, nil, 0

        if profile and profile.Backpack and profile.Backpack.Slots then
            local slots = profile.Backpack.Slots

            -- ตรวจสอบช่องคีย์ลัด 1-6 ก่อน
            for s = 1, 6 do
                local it = slots[s]
                if it and it.ItemId and it.ItemId ~= "" then
                    local sItem = ConfigModule and ConfigModule.ShopItem and ConfigModule.ShopItem(it.ItemId)
                    local kind = sItem and sItem.Kind
                    if (kind and ConfigModule.IsFishingRodKind and ConfigModule.IsFishingRodKind(kind)) or tostring(it.ItemId):lower():find("rod") then
                        rodSlot = s
                        rodId = it.ItemId
                        break
                    end
                end
            end

            -- ถ้าไม่เจอในช่องลัด ตรวจสอบในกระเป๋า (ช่อง 9 เป็นต้นไป)
            if not rodSlot then
                for s, it in pairs(slots) do
                    local slotNum = tonumber(s) or 0
                    if slotNum >= 9 and it and it.ItemId and it.ItemId ~= "" then
                        local sItem = ConfigModule and ConfigModule.ShopItem and ConfigModule.ShopItem(it.ItemId)
                        local kind = sItem and sItem.Kind
                        if (kind and ConfigModule.IsFishingRodKind and ConfigModule.IsFishingRodKind(kind)) or tostring(it.ItemId):lower():find("rod") then
                            rodSlot = slotNum
                            rodId = it.ItemId
                            break
                        end
                    end
                end
            end

            -- ค้นหาเหยื่อที่รองรับ
            if rodId then
                for s, it in pairs(slots) do
                    if it and it.ItemId and it.ItemId ~= "" and s ~= rodSlot then
                        local sItem = ConfigModule and ConfigModule.ShopItem and ConfigModule.ShopItem(it.ItemId)
                        local kind = sItem and sItem.Kind
                        local isBait = (kind and ConfigModule.IsBaitKind and ConfigModule.IsBaitKind(kind)) or tostring(it.ItemId):lower():find("bait")
                        if isBait and (not FishingCompatModule or not FishingCompatModule.Allows or FishingCompatModule.Allows(rodId, it.ItemId)) then
                            baitSlot = s
                            baitId = it.ItemId
                            baitQty = tonumber(it.Qty or it.qty) or 1
                            break
                        end
                    end
                end
            end
        end

        if not rodSlot then
            local catId = tostring(LocalPlayer:GetAttribute("CSGO_CatalogId") or "")
            if catId:lower():find("rod") then
                rodSlot = tonumber(LocalPlayer:GetAttribute("CSGO_ActiveSlot")) or 1
                rodId = catId
            end
        end

        return rodSlot, rodId, baitSlot, baitId, baitQty
    end

    local function EnsureRodEquipped(rodSlot, rodId)
        if not rodSlot then return false end

        -- ถ้าเบ็ดอยู่ในกระเป๋า ให้ย้ายมาที่ช่องลัด 3
        if rodSlot >= 9 and SwapBagSlotRemote then
            SwapBagSlotRemote:FireServer(rodSlot, 3)
            task.wait(0.35)
            rodSlot = 3
        end

        local activeSlot = tonumber(LocalPlayer:GetAttribute("CSGO_ActiveSlot")) or 0
        if activeSlot ~= rodSlot and SwitchWeaponRequestRemote then
            SwitchWeaponRequestRemote:FireServer(rodSlot)
            local t0 = os.clock()
            while os.clock() - t0 < 0.8 do
                if tonumber(LocalPlayer:GetAttribute("CSGO_ActiveSlot")) == rodSlot then
                    break
                end
                task.wait(0.05)
            end
        end

        return tonumber(LocalPlayer:GetAttribute("CSGO_ActiveSlot")) == rodSlot
    end

    local function CalculateNextZoneHit(biteAt, speed, zoneCenter, now)
        local uNow = (now - biteAt) * speed
        local z = zoneCenter
        local minU = uNow + 0.04 * speed

        local bestU = nil
        local kStart = math.floor(uNow / 2)
        for k = kStart, kStart + 6 do
            local u1 = 2 * k + z
            if u1 >= minU and (bestU == nil or u1 < bestU) then
                bestU = u1
            end
            local u2 = 2 * k + (2 - z)
            if u2 >= minU and (bestU == nil or u2 < bestU) then
                bestU = u2
            end
        end

        if bestU then
            return biteAt + (bestU / speed)
        end
        return now + 0.1
    end

    local function CastRod(rSlot, bSlot, bId)
        local waterPoint = (getgenv()._WarzGetValidWaterCastPoint and getgenv()._WarzGetValidWaterCastPoint()) or (GetValidWaterCastPoint and GetValidWaterCastPoint())
        if not waterPoint then
            return false, "no_water"
        end

        if type(FishingModule) == "table" and FishingModule.Press then
            local ups = getupvalues(FishingModule.Press)
            local sendCast = ups[7]
            if type(sendCast) == "function" then
                pcall(setupvalue, sendCast, 10, waterPoint)
                pcall(setupvalue, sendCast, 11, bId)
                pcall(setupvalue, sendCast, 12, bSlot)
            end
        end

        if FishingStartRemote then
            FishingStartRemote:FireServer(rSlot, bSlot, waterPoint)
            return true
        else
            pcall(function() FishingModule.Press() end)
            return true
        end
    end

    -- Auto Fishing State & Precision Reel Logic
    local activeReelThread = nil
    local lastResultTime = 0
    local isCastingInProgress = false

    if FishingStateRemote then
        FishingStateRemote.OnClientEvent:Connect(function(state)
            if not AutoFishToggle.Value or typeof(state) ~= "table" then return end

            if state.phase == "cast" then
                isCastingInProgress = true
            elseif state.phase == "reel" then
                isCastingInProgress = false
                if activeReelThread then
                    pcall(task.cancel, activeReelThread)
                    activeReelThread = nil
                end

                activeReelThread = task.spawn(function()
                    local biteAt = tonumber(state.biteAt) or Workspace:GetServerTimeNow()
                    local speed = tonumber(state.speed) or 1
                    local zoneCenter = tonumber(state.zoneCenter) or 0.5
                    local zoneWidth = tonumber(state.zoneWidth) or 0.2
                    local deadline = tonumber(state.deadline) or (Workspace:GetServerTimeNow() + 4)

                    local function getMarkerPos(t)
                        local v = (t - biteAt) * speed % 2
                        if v < 0 then v = v + 2 end
                        if v >= 1 then v = 2 - v end
                        return v
                    end

                    local tNow = Workspace:GetServerTimeNow()
                    local curPos = getMarkerPos(tNow)

                    -- ถ้า Marker อยู่ในแถบเขียวอยู่แล้ว ให้ตวัดทันที
                    if math.abs(curPos - zoneCenter) <= (zoneWidth / 2) * 0.75 then
                        if FishingReelRemote then
                            FishingReelRemote:FireServer(state.castId, tNow)
                        end
                        return
                    end

                    -- คำนวณหา Timestamp ที่จะเข้าสู่จุดกึ่งกลางแถบเขียว 100%
                    local tHit = CalculateNextZoneHit(biteAt, speed, zoneCenter, tNow)
                    if tHit > deadline - 0.05 then
                        tHit = deadline - 0.08
                    end

                    local delta = tHit - Workspace:GetServerTimeNow()
                    if delta > 0.05 then
                        task.wait(delta - 0.02)
                    end

                    while Workspace:GetServerTimeNow() < tHit - 0.002 do
                        RunService.Heartbeat:Wait()
                    end

                    if AutoFishToggle.Value and FishingReelRemote then
                        local finalNow = Workspace:GetServerTimeNow()
                        FishingReelRemote:FireServer(state.castId, finalNow)
                    end
                end)
            elseif state.phase == "result" or state.phase == "cancel" or state.phase == "idle" then
                isCastingInProgress = false
                lastResultTime = Workspace:GetServerTimeNow()
                if activeReelThread then
                    pcall(task.cancel, activeReelThread)
                    activeReelThread = nil
                end

                -- แจ้งเตือนเมื่อตกปลาสำเร็จ
                if state.phase == "result" and state.ok and Fluent and Fluent.Notify then
                    local rewardText = "ได้ของแล้ว!"
                    if type(state.rewards) == "table" and #state.rewards > 0 then
                        local items = {}
                        for _, rw in ipairs(state.rewards) do
                            table.insert(items, tostring(rw.name or rw.itemId or "Item") .. " x" .. tostring(rw.qty or 1))
                        end
                        rewardText = table.concat(items, ", ")
                    elseif state.itemId then
                        rewardText = tostring(state.name or state.itemId) .. " x" .. tostring(state.qty or 1)
                    end
                    Fluent:Notify({
                        Title = "Auto Fishing (สำเร็จ)",
                        Content = rewardText,
                        Duration = 2
                    })
                end

                -- หน่วงเวลารอ Animation รางวัลจบ (2.6 วินาที) แล้วเหวี่ยงต่ออย่างราบรื่น
                task.delay(2.6, function()
                    if not AutoFishToggle.Value then return end
                    local isActive = false
                    pcall(function()
                        isActive = FishingModule and FishingModule.IsActive and FishingModule.IsActive()
                    end)
                    if not isActive and not isCastingInProgress then
                        local prof = GetFishingProfile()
                        local rSlot, rId, bSlot, bId, bQty = FindFishingRodAndBait(prof)
                        if rSlot and EnsureRodEquipped(rSlot, rId) then
                            if bQty and bQty <= 0 then
                                Fluent:Notify({
                                    Title = "Auto Fishing",
                                    Content = "เหยื่อหมดแล้ว! กรุณาเติมเหยื่อ",
                                    Duration = 3
                                })
                                return
                            end
                            CastRod(rSlot, bSlot, bId)
                        end
                    end
                end)
            end
        end)
    end


    -- Auto Fishing Watchdog & Cast Loop
    task.spawn(function()
        local lastBaitWarning = 0
        local castStartTime = 0

        while true do
            task.wait(1.2)
            if AutoFishToggle.Value and FishingModule then
                local isActive = false
                pcall(function()
                    isActive = FishingModule.IsActive and FishingModule.IsActive()
                end)

                if isActive then
                    if castStartTime == 0 then
                        castStartTime = os.clock()
                    elseif os.clock() - castStartTime > 16 then
                        -- Stuck watchdog: เหวี่ยงค้างเกิน 16 วินาที ให้ยกเลิกแล้วเหวี่ยงใหม่
                        pcall(function()
                            if FishingModule.Cancel then
                                FishingModule.Cancel()
                            end
                        end)
                        castStartTime = 0
                        task.wait(1)
                    end
                else
                    castStartTime = 0
                    local timeSinceResult = Workspace:GetServerTimeNow() - lastResultTime
                    if timeSinceResult >= 2.5 and not isCastingInProgress then
                        local prof = GetFishingProfile()
                        local rSlot, rId, bSlot, bId, bQty = FindFishingRodAndBait(prof)

                        if not rSlot then
                            if os.clock() - lastBaitWarning > 8 and Fluent and Fluent.Notify then
                                lastBaitWarning = os.clock()
                                Fluent:Notify({
                                    Title = "Auto Fishing",
                                    Content = "ไม่พบคันเบ็ดในกระเป๋า!",
                                    Duration = 3
                                })
                            end
                        elseif bSlot == nil or (bQty and bQty <= 0) then
                            if os.clock() - lastBaitWarning > 8 and Fluent and Fluent.Notify then
                                lastBaitWarning = os.clock()
                                Fluent:Notify({
                                    Title = "Auto Fishing",
                                    Content = "เหยื่อตกปลาหมด! กรุณาใส่เหยื่อในกระเป๋า",
                                    Duration = 3
                                })
                            end
                        else
                            local equipped = EnsureRodEquipped(rSlot, rId)
                            if equipped then
                                isCastingInProgress = true
                                local ok, err = CastRod(rSlot, bSlot, bId)
                                if not ok and err == "no_water" and os.clock() - lastBaitWarning > 8 and Fluent and Fluent.Notify then
                                    lastBaitWarning = os.clock()
                                    Fluent:Notify({
                                        Title = "Auto Fishing",
                                        Content = "ไม่พบผิวน้ำด้านหน้า กรุณายืนใกล้แหล่งน้ำ",
                                        Duration = 3
                                    })
                                end
                                task.wait(1)
                                isCastingInProgress = false
                            end
                        end
                    end
                end
            end
        end
    end)

