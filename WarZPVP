    -- Real-time Camera Aim Engine
    local function updateCameraAim()
        if not (AimbotToggle and AimbotToggle.Value) then
            lockedTargetChar = nil
            return
        end

        local isTriggerActive = false
        local triggerMode = tostring(LockTriggerDropdown.Value)
        if triggerMode:find("Always") or triggerMode:find("ตลอด") then
            isTriggerActive = true
        elseif triggerMode:find("Right") or triggerMode:find("ขวา") then
            isTriggerActive = isRightDown or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
        else
            isTriggerActive = isLeftDown or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
        end

        if not isTriggerActive then
            lockedTargetChar = nil
            return
        end

        local targetRawPos = nil
        if lockedTargetChar and isCharacterAlive(lockedTargetChar) then
            local pos = getTargetPartPosition(lockedTargetChar)
            if pos and isTargetVisible(pos, lockedTargetChar) then
                targetRawPos = pos
            end
        end

        if not targetRawPos then
            local pos, _, char = getBestTarget()
            targetRawPos = pos
            lockedTargetChar = char
        end

        if not targetRawPos then
            return
        end

        local aimTargetPos = applyPrediction(targetRawPos, lockedTargetChar)
        local currentCF = Camera.CFrame
        local targetCF = CFrame.lookAt(currentCF.Position, aimTargetPos)

        local smooth = math.max(1, tonumber(AimSmoothSlider.Value) or 1)
        local newCF = (smooth <= 1) and targetCF or currentCF:Lerp(targetCF, 1 / smooth)
        Camera.CFrame = newCF

        local look = newCF.LookVector
        local targetYaw = math.atan2(-look.X, -look.Z)
        local targetPitch = math.asin(math.clamp(look.Y, -1, 1))

        if WarzCameraModule then
            pcall(function()
                debug.setupvalue(WarzCameraModule.GetYaw, 1, targetYaw)
                debug.setupvalue(WarzCameraModule.GetPitch, 1, targetPitch)
            end)
        end

        pcall(function()
            LocalPlayer:SetAttribute("CSGO_Pitch", targetPitch)
            LocalPlayer:SetAttribute("CSGO_Yaw", targetYaw)
        end)
    end

    -- Run at Priority 1999 (Last.Value - 1) to override camera right after WarzCamera step (Priority 1998)
    RunService:BindToRenderStep("WarZ_Precision_Aim", Enum.RenderPriority.Last.Value - 1, updateCameraAim)

    -- Combat Loop
    if getgenv()._WarzCombatConn then
        pcall(function() getgenv()._WarzCombatConn:Disconnect() end)
        getgenv()._WarzCombatConn = nil
    end
    getgenv()._WarzCombatConn = RunService.RenderStepped:Connect(function()
        local mousePos = UserInputService:GetMouseLocation()

        -- FOV Circle Update
        if fovCircle then
            fovCircle.Visible = (AimbotToggle.Value or SilentAimToggle.Value) and ShowFovToggle.Value
            fovCircle.Radius = tonumber(AimFovSlider.Value) or 250
            fovCircle.Color = FovCircleColor.Value
            fovCircle.Position = mousePos
        end

        -- Snapline Update
        if snapLine then
            if ShowSnaplineToggle.Value and lockedTargetChar and isCharacterAlive(lockedTargetChar) then
                local rawPos = getTargetPartPosition(lockedTargetChar)
                if rawPos then
                    local sPos, onScreen = Camera:WorldToViewportPoint(rawPos)
                    if onScreen and sPos.Z > 0 then
                        local vp = Camera.ViewportSize
                        snapLine.From = Vector2.new(vp.X / 2, vp.Y)
                        snapLine.To = Vector2.new(sPos.X, sPos.Y)
                        snapLine.Visible = true
                    else
                        snapLine.Visible = false
                    end
                else
                    snapLine.Visible = false
                end
            else
                snapLine.Visible = false
            end
        end

        -- Render Neck Red Dots on Enemies & Targets
        local showNeckDots = (NeckRedDotToggle and NeckRedDotToggle.Value == true)
        local dotColor = (NeckRedDotColor and NeckRedDotColor.Value) or Color3.fromRGB(255, 30, 30)

        local function cleanupPartDots(part)
            if not part then return end
            for _, name in ipairs({"WarZ_HeadRedDot", "WarZ_NeckRedDot", "WarZ_HeadRedDotGui", "WarZ_NeckRedDotGui"}) do
                local d = part:FindFirstChild(name)
                if d then pcall(function() d:Destroy() end) end
            end
        end

        local function updateNeckDot(character, isDead)
            if not character then return end
            local head = character:FindFirstChild("Head")
            local ut = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
            local hrp = character:FindFirstChild("HumanoidRootPart")

            -- Clean up any dots attached to torso or root part so they NEVER linger on neck/chest
            cleanupPartDots(ut)
            cleanupPartDots(hrp)

            if not showNeckDots or isDead or not isCharacterAlive(character) then
                cleanupPartDots(head)
                return
            end

            local adornee = (head and head:IsA("BasePart")) and head or ut
            if adornee and adornee:IsDescendantOf(workspace) then
                local offset = (adornee == head) and Vector3.zero or Vector3.new(0, adornee.Size.Y * 0.5 + 0.6, 0)

                -- 1. 3D Adornment Sphere (Hardware-locked directly to Head bone in C++)
                local sp = adornee:FindFirstChild("WarZ_HeadRedDot")
                if not sp then
                    sp = Instance.new("SphereHandleAdornment")
                    sp.Name = "WarZ_HeadRedDot"
                    sp.Radius = 0.4
                    sp.AlwaysOnTop = true
                    sp.ZIndex = 10
                    sp.Adornee = adornee
                    sp.CFrame = CFrame.new(offset)
                    sp.Color3 = dotColor
                    sp.Transparency = 0
                    sp.Parent = adornee
                else
                    if sp.Adornee ~= adornee then sp.Adornee = adornee end
                    if sp.CFrame.Position ~= offset then sp.CFrame = CFrame.new(offset) end
                    if sp.Color3 ~= dotColor then sp.Color3 = dotColor end
                    if sp.Radius ~= 0.4 then sp.Radius = 0.4 end
                end

                -- 2. 2D Billboard Indicator (Hardware-locked to Head bone, 0ms delay, visible from any range)
                local bg = adornee:FindFirstChild("WarZ_HeadRedDotGui")
                if not bg then
                    bg = Instance.new("BillboardGui")
                    bg.Name = "WarZ_HeadRedDotGui"
                    bg.Adornee = adornee
                    bg.StudsOffset = offset
                    bg.Size = UDim2.fromOffset(8, 8)
                    bg.AlwaysOnTop = true

                    local fr = Instance.new("Frame")
                    fr.Name = "Dot"
                    fr.Size = UDim2.fromScale(1, 1)
                    fr.BorderSizePixel = 0
                    fr.BackgroundColor3 = dotColor

                    local uc = Instance.new("UICorner")
                    uc.CornerRadius = UDim.new(1, 0)
                    uc.Parent = fr

                    local st = Instance.new("UIStroke")
                    st.Name = "Stroke"
                    st.Color = Color3.new(1, 1, 1)
                    st.Thickness = 1
                    st.Parent = fr

                    fr.Parent = bg
                    bg.Parent = adornee
                else
                    if bg.Adornee ~= adornee then bg.Adornee = adornee end
                    if bg.StudsOffset ~= offset then bg.StudsOffset = offset end
                    local fr = bg:FindFirstChild("Dot")
                    if fr and fr.BackgroundColor3 ~= dotColor then
                        fr.BackgroundColor3 = dotColor
                    end
                end
            end
        end

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                updateNeckDot(player.Character, player:GetAttribute("CSGO_Dead") == true or player:GetAttribute("WarzDead") == true)
            end
        end

        for _, containerName in ipairs({"WarzDummies", "Targets", "Zombies"}) do
            local container = workspace:FindFirstChild(containerName)
            if container then
                for _, obj in ipairs(container:GetChildren()) do
                    updateNeckDot(obj, false)
                end
            end
        end


        -- Hitbox Expander
        if HitboxExpanderToggle.Value then
            lastHitboxState = true
            local hSize = tonumber(HitboxSizeSlider.Value) or 3.5
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character then
                    local head = player.Character:FindFirstChild("Head")
                    if head and head:IsA("BasePart") then
                        head.Size = Vector3.new(hSize, hSize, hSize)
                        head.Transparency = 0.5
                        head.CanCollide = false
                        head.CanQuery = true
                        head.Massless = true
